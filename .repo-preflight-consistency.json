{
  "$schema": "https://raw.githubusercontent.com/nexus-ai-2045/repo-preflight/main/schemas/repository-consistency.schema.json",
  "schema": "repo-preflight.consistency/v1",
  "mode": "shadow",
  "ratchet": {"baseline": []},
  "markdown": {"include": ["README.md", "runners/**/*.md"]},
  "readme_contracts": {
    "required_paths": ["autopilot.py", "config.example.json", "jobs/sim-smoke/job.json"],
    "commands": [
      {"text": "python autopilot.py queue", "paths": ["autopilot.py"]},
      {"text": "cp config.example.json config.local.json", "paths": ["config.example.json"]}
    ]
  },
  "impact_map": [
    {"change": ["core/**", "runners/**"], "requires_any": ["README.md", "runners/**", "tests/**"]}
  ]
}
